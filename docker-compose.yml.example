services:
  app:
    build: .
    container_name: agtech-app
    ports:
      - "8080:8080"
    environment:
      SPRING_DATASOURCE_URL: jdbc:oracle:thin:@<HOST>:<PORTA>:<SID>
      SPRING_DATASOURCE_USERNAME: <SEU_USUARIO>
      SPRING_DATASOURCE_PASSWORD: <SUA_SENHA>
      JWT_SECRET: <SUA_CHAVE_JWT>